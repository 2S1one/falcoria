# Copy to .env and fill in. All vars are prefixed SCANLEDGER_ (SCANLEDGER_DB_ for the database).

SCANLEDGER_ENV=local
SCANLEDGER_DEBUG=false

# Bearer tokens for the seeded admin / tasker accounts. Re-applied on every startup;
# must differ from each other.
SCANLEDGER_ADMIN_TOKEN=change-me-admin
SCANLEDGER_TASKER_TOKEN=change-me-tasker

# Matches compose.yaml (host port 5433 -> container 5432).
SCANLEDGER_DB_HOST=localhost
SCANLEDGER_DB_PORT=5433
SCANLEDGER_DB_USER=scanledger
SCANLEDGER_DB_PASSWORD=scanledger
SCANLEDGER_DB_NAME=scanledger
