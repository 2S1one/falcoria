# Copy to .env and fill in. All vars are prefixed WORKER_ (WORKER_TEMPORAL_ for
# the Temporal client).

WORKER_ENV=local
WORKER_DEBUG=false

# Base URL of scanledger's API and worker's own service-account token. Must
# match scanledger's own SCANLEDGER_WORKER_TOKEN — same secret on both sides.
WORKER_SCANLEDGER_BASE_URL=http://localhost:8000/api
WORKER_SCANLEDGER_TOKEN=change-me-worker

# Path to the nmap executable.
WORKER_NMAP_PATH=nmap

# Max concurrent child ScanWorkflows inside one ScanBatchWorkflow.
WORKER_WINDOW_SIZE=20

# Matches compose.yaml (temporal service on host port 7233).
WORKER_TEMPORAL_ADDRESS=localhost:7233
WORKER_TEMPORAL_NAMESPACE=default
