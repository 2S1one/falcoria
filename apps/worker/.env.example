# Copy to .env and fill in. All vars are prefixed WORKER_ (WORKER_TEMPORAL_ for
# the Temporal client, WORKER_TEMPORAL_TLS_ for Temporal TLS/mTLS).

WORKER_ENV=local
WORKER_DEBUG=false

# Base URL of scanledger's API and worker's own service-account token. Must
# match scanledger's own SCANLEDGER_WORKER_TOKEN — same secret on both sides.
WORKER_SCANLEDGER_BASE_URL=http://localhost:8000/api
WORKER_SCANLEDGER_TOKEN=change-me-worker
# Set to false if scanledger uses a self-signed certificate in staging/prod.
WORKER_SCANLEDGER_TLS_VERIFY=true

# Path to the nmap executable.
WORKER_NMAP_PATH=nmap

# Max concurrent child ScanWorkflows inside one ScanBatchWorkflow.
WORKER_WINDOW_SIZE=20

# Matches compose.yaml (temporal service on host port 7233).
WORKER_TEMPORAL_ADDRESS=localhost:7233
WORKER_TEMPORAL_NAMESPACE=default

# Temporal TLS / mTLS settings.
# For plain local connection, leave ENABLED=false.
# For mTLS, configure the certificate and key paths mounted into the worker.
WORKER_TEMPORAL_TLS_ENABLED=false
# WORKER_TEMPORAL_TLS_CLIENT_CERT_PATH=/etc/falcoria/certs/client.crt
# WORKER_TEMPORAL_TLS_CLIENT_KEY_PATH=/etc/falcoria/certs/client.key
# WORKER_TEMPORAL_TLS_SERVER_ROOT_CA_CERT_PATH=/etc/falcoria/certs/ca.crt
# WORKER_TEMPORAL_TLS_DOMAIN=temporal.example.com
