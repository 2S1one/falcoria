# Copy to .env and fill in. All vars are prefixed TASKER_ (TASKER_TEMPORAL_ for
# the Temporal client). Exact field names may still shift once config.py lands.

TASKER_ENV=local
TASKER_DEBUG=false

# Max concurrent in-flight DNS lookups during target resolution. Defaults to 100.
TASKER_DNS_RESOLVE_SEMAPHORE_LIMIT=100

# Base URL of scanledger's API and the shared "tasker" service-account token
# (Q1: tasker delegates auth to scanledger). Must match scanledger's own
# SCANLEDGER_TASKER_TOKEN — same secret on both sides.
TASKER_SCANLEDGER_BASE_URL=http://localhost:8000/api
TASKER_SCANLEDGER_TOKEN=change-me-tasker

# Matches compose.yaml (temporal service on host port 7233).
TASKER_TEMPORAL_ADDRESS=localhost:7233
TASKER_TEMPORAL_NAMESPACE=default
