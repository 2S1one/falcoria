WORKER_ENV=prod
WORKER_LOG_LEVEL={{ worker_log_level }}

# Control Plane endpoints
WORKER_TEMPORAL_ADDRESS={{ worker_temporal_address }}
WORKER_SCANLEDGER_BASE_URL={{ worker_scanledger_base_url }}
WORKER_SCANLEDGER_TOKEN={{ vault_scanledger_worker_token }}
{% if worker_ssl_cert_file is defined and worker_ssl_cert_file %}
SSL_CERT_FILE={{ worker_ssl_cert_file }}
{% endif %}

# mTLS credentials (mounted into /etc/falcoria/certs)
WORKER_TEMPORAL_TLS_ENABLED={{ worker_temporal_tls_enabled | lower }}
WORKER_TEMPORAL_TLS_CLIENT_CERT_PATH=/etc/falcoria/certs/worker.crt
WORKER_TEMPORAL_TLS_CLIENT_KEY_PATH=/etc/falcoria/certs/worker.key
{% if worker_temporal_tls_server_root_ca_cert_path is defined and worker_temporal_tls_server_root_ca_cert_path %}
WORKER_TEMPORAL_TLS_SERVER_ROOT_CA_CERT_PATH={{ worker_temporal_tls_server_root_ca_cert_path }}
{% endif %}

# Scanner execution tuning
WORKER_MAX_CONCURRENT_ACTIVITIES={{ worker_max_concurrent_activities }}
WORKER_WINDOW_SIZE={{ worker_window_size }}
